RewriteEngine on 
ErrorDocument 404 /404.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteCond %{REQUEST_FILENAME} !-d 
RewriteCond %{REQUEST_FILENAME}\.php -f 
RewriteRule ^(.*)$ $1.php

RewriteCond %{HTTP_HOST} ^dermatales\.com [NC]
RewriteRule ^(.*)$ https://www.dermatales.com/$1 [L,R=301]

# To externally redirect /dir/foo.php to /dir/foo
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=302,L,NE]

Redirect 301 /btx-a-treatment-in-gurgaon https://www.dermatales.com/botox-treatment-in-gurgaon
Redirect 301 /chin-augmentation-in-delhi-patel-nagar https://www.dermatales.com/chin-augmentation-in-delhi
Redirect 301 /blog/why-your-friends-botox-looks-natural-and-yours-looks-done https://www.dermatales.com/blog/why-some-botox-results-look-natural-while-others-look-overdone
Redirect 301 /blog/starting-your-bridal-skin-prep-three-weeks-before-the-wedding-is-too-late-and-indian-skin-is-the-reason https://www.dermatales.com/blog/bridal-skin-prep-timeline-indian-skin
Redirect 301 /blog/your-dandruff-gets-worse-every-winter-because-it-may-not-be-dandruff https://www.dermatales.com/blog/dandruff-worse-in-winter-seborrheic-dermatitis

